{
  "name": "linux-day-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "next build",
    "start": "next build && NODE_ENV=production node server.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "node -e \"const{chmodSync,existsSync}=require('fs');for(const p of ['node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper','node_modules/node-pty/prebuilds/darwin-x64/spawn-helper','node_modules/node-pty/prebuilds/linux-arm64/spawn-helper','node_modules/node-pty/prebuilds/linux-x64/spawn-helper','node_modules/node-pty/build/Release/spawn-helper'])if(existsSync(p))chmodSync(p,0o755)\"",
    "provision": "sudo bash infra/provision.sh",
    "teste": "node testes/e2e.mjs",
    "teste:ui": "node testes/ui.mjs",
    "teste:tudo": "npm run teste:tempo && npm run teste:novidades && npm run teste && npm run teste:equipes && npm run teste:chamado && npm run teste:justica && npm run teste:terminal && npm run teste:ui && npm run teste:widgets && npm run teste:deck",
    "teste:widgets": "node testes/ui-widgets.mjs",
    "teste:deck": "node testes/ui-deck.mjs",
    "start:rapido": "NODE_ENV=production node server.mjs",
    "limpar": "rm -rf data && mkdir -p data",
    "rede": "node scripts/rede.mjs",
    "ilustracoes": "node scripts/extrair-ilustracoes.mjs",
    "teste:terminal": "node testes/terminal.mjs",
    "teste:justica": "node testes/justica.mjs",
    "teste:tempo": "node testes/tempo.mjs",
    "teste:equipes": "node testes/equipes.mjs",
    "teste:novidades": "node testes/novidades.mjs",
    "teste:chamado": "node testes/chamado-e-roleta.mjs",
    "teste:stress": "node testes/stress.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.59.0",
    "next": "^15.1.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-kawaii": "^1.6.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@svgmoji/noto": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.64.1",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
